{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",                       // ← Cambio CLAVE
    "rootDir": "src",
    "outDir": "dist",
    "strict": false,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types"],
    "baseUrl": "./"
  },
  "include": ["src"]
}
